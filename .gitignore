# ── 비밀값 ──────────────────────────────────────────
# 환경변수 파일(API 키, 비밀번호 등)
.env
# 환경별 환경변수 파일(.env.local, .env.production 등)
.env.*
# 환경변수 예시 파일은 비밀값이 없으므로 저장소에 포함
!.env.example
# 인증서·개인 키 파일
*.pem
*.key

# ── 개인정보가 든 원자료 ───────────────────────────
# 원자료 폴더(영문)
raw/
# 원자료 폴더(한글)
원자료/
# 개인정보가 든 자료 폴더
개인정보/

# ── 운영체제 자동 생성 파일 ────────────────────────
# macOS 폴더 설정 파일
.DS_Store
# Windows 썸네일 캐시 파일
Thumbs.db

# ── 한글·오피스 임시 파일 ──────────────────────────
# MS Office가 문서를 열어 둘 때 만드는 잠금 파일(~$문서.docx 등)
~$*
# 한글(HWP) 자동 저장·백업 파일
*.hwp.bak
*.hwpx.bak
# 한글(HWP) 임시 파일
*.tmp
# Office 자동 복구용 임시 파일
~*.tmp

# ── 문서 형식 ──────────────────────────────────────
# PDF 파일
*.pdf

# ── 비공개 검토 자료 ───────────────────────────────
# 미공개 논문 제목·검토 내용이 담긴 산출물 폴더
out/
# 병원·진료과 이름과 내 컴퓨터 폴더 경로가 담긴 스킬 폴더
.claude/skills/

# ── Claude Code 개인 설정 ──────────────────────────
# 내 컴퓨터에서만 쓰는 Claude Code 로컬 설정
.claude/settings.local.json
